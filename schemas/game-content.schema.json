{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarv-genie.local/schemas/game-content.schema.json",
  "title": "Local Generated Game Content",
  "type": "object",
  "required": ["title", "theme", "setting", "objective", "player", "npc", "enemy", "collectible", "quest"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "theme": { "enum": ["sky-dragon", "dark-fantasy", "adventure"] },
    "setting": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "player": {
      "type": "object",
      "required": ["name", "role"],
      "properties": { "name": { "type": "string" }, "role": { "type": "string" } },
      "additionalProperties": false
    },
    "npc": {
      "type": "object",
      "required": ["name", "role", "dialogue"],
      "properties": { "name": { "type": "string" }, "role": { "type": "string" }, "dialogue": { "type": "string" } },
      "additionalProperties": false
    },
    "enemy": {
      "type": "object",
      "required": ["name", "role", "health", "attack"],
      "properties": { "name": { "type": "string" }, "role": { "type": "string" }, "health": { "type": "integer", "minimum": 1, "maximum": 10 }, "attack": { "type": "integer", "minimum": 1, "maximum": 4 } },
      "additionalProperties": false
    },
    "collectible": {
      "type": "object",
      "required": ["name", "count", "color"],
      "properties": { "name": { "type": "string" }, "count": { "type": "integer", "minimum": 1, "maximum": 8 }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
      "additionalProperties": false
    },
    "quest": {
      "type": "object",
      "required": ["name", "brief", "reward"],
      "properties": { "name": { "type": "string" }, "brief": { "type": "string" }, "reward": { "type": "string" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
